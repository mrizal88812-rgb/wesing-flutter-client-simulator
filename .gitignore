*.pyc
*.pyo
*.pyd
.Python
*.so

# Node artifacts (if any JS/TS files exist in the project)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled Binary files
*.exe
*.dll
*.so
*.a
*.o
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
